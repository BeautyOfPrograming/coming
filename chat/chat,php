<?php
header('Content-Type: application/json');
require_once __DIR__ . '/../includes/config.php';
require_once __DIR__ . '/../includes/database.php';

// Start session
session_start();

// Verify authentication
if (!isset($_SESSION['user_id'])) {
    http_response_code(401);
    echo json_encode(['error' => 'Unauthorized']);
    exit;
}

$db = getDatabaseConnection();

// Get messages between current user and another user/driver
if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    if (!isset($_GET['other_id'])) {
        http_response_code(400);
        echo json_encode(['error' => 'Missing other_id parameter']);
        exit;
    }

    $other_id = filter_var($_GET['other_id'], FILTER_VALIDATE_INT);
    if (!$other_id) {
        http_response_code(400);
        echo json_encode(['error' => 'Invalid other_id']);
        exit;
    }

    // Get messages where current user is either sender or receiver with the other user
    $stmt = $db->prepare("
        SELECT m.*, 
               u.name as sender_name,
               u.photo as sender_photo,
               u.user_type as sender_type
        FROM messages m
        JOIN users u ON m.sender_id = u.id
        WHERE (m.sender_id = ? AND m.receiver_id = ?)
           OR (m.sender_id = ? AND m.receiver_id = ?)
        ORDER BY m.sent_at ASC
    ");
    $stmt->execute([$_SESSION['user_id'], $other_id, $other_id, $_SESSION['user_id']]);
    $messages = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Mark messages as read
    $stmt = $db->prepare("
        UPDATE messages 
        SET is_read = TRUE 
        WHERE receiver_id = ? AND sender_id = ? AND is_read = FALSE
    ");
    $stmt->execute([$_SESSION['user_id'], $other_id]);

    echo json_encode(['messages' => $messages]);
    exit;
}

// Send a new message
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $data = json_decode(file_get_contents('php://input'), true);

    if (!isset($data['receiver_id']) || !isset($data['content']) || empty(trim($data['content']))) {
        http_response_code(400);
        echo json_encode(['error' => 'Missing required fields']);
        exit;
    }

    $receiver_id = filter_var($data['receiver_id'], FILTER_VALIDATE_INT);
    $content = trim($data['content']);

    if (!$receiver_id || empty($content)) {
        http_response_code(400);
        echo json_encode(['error' => 'Invalid data']);
        exit;
    }

    // Check if receiver exists
    $stmt = $db->prepare("SELECT id FROM users WHERE id = ?");
    $stmt->execute([$receiver_id]);
    if (!$stmt->fetch()) {
        http_response_code(404);
        echo json_encode(['error' => 'Receiver not found']);
        exit;
    }

    // Insert new message
    $stmt = $db->prepare("
        INSERT INTO messages (sender_id, receiver_id, content)
        VALUES (?, ?, ?)
    ");
    $stmt->execute([$_SESSION['user_id'], $receiver_id, $content]);
    $message_id = $db->lastInsertId();

    // Get the full message data to return
    $stmt = $db->prepare("
        SELECT m.*, 
               u.name as sender_name,
               u.photo as sender_photo,
               u.user_type as sender_type
        FROM messages m
        JOIN users u ON m.sender_id = u.id
        WHERE m.id = ?
    ");
    $stmt->execute([$message_id]);
    $message = $stmt->fetch(PDO::FETCH_ASSOC);

    // In a real app, you would implement WebSocket or push notifications here
    // For now, we'll just return the message

    echo json_encode(['message' => $message]);
    exit;
}

http_response_code(405);
echo json_encode(['error' => 'Method not allowed']);